# Copy to .env or export in the shell. No credentials are stored in code.
DATABASE_URL=postgresql://user:password@localhost:5432/iris
TED_API_URL=https://api.ted.europa.eu/v3/notices/search
TED_COUNTRIES=DEU
TED_PAGE_LIMIT=100
